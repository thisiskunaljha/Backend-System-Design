# Copy this file to .env and fill values for local development
# IMPORTANT: Never commit .env to version control

# Django Settings
SECRET_KEY=django-insecure-REPLACE_THIS_WITH_A_SECURE_KEY
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=sqlite:///./db.sqlite3

# Google OAuth 2.0
# Get these from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID for Web application
# Set Authorized redirect URIs:
#   - http://localhost:8000/accounts/google/login/callback/
#   - http://127.0.0.1:8000/accounts/google/login/callback/
# For production: https://yourdomain.com/accounts/google/login/callback/
SOCIAL_AUTH_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
SOCIAL_AUTH_GOOGLE_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

# CSRF Settings (for production)
CSRF_TRUSTED_ORIGIN=https://yourdomain.com
